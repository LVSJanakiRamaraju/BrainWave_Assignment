VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Local only: use the hosted Supabase Functions URL in production, or omit this line.
VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Set these with `supabase secrets set` for the zoho-proxy edge function.
# Do not add them to the Vite `.env` file or expose them to the browser.
# ZOHO_CLIENT_ID=your-zoho-client-id
# ZOHO_CLIENT_SECRET=your-zoho-client-secret
# ZOHO_REFRESH_TOKEN=your-zoho-refresh-token